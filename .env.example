# Modo de chequeo:
#   local -> ejecuta 'pm2 jlist' en la misma máquina (recomendado si el watchdog corre en mecopia-admin-server)
#   ssh   -> se conecta por SSH y ejecuta 'pm2 jlist' (útil para monitorizar desde fuera)
CHECK_MODE=local

# Solo si CHECK_MODE=ssh: host definido en ~/.ssh/config
SSH_HOST=mecopia-admin-server

# Servicios PM2 a vigilar, separados por comas
PM2_SERVICES=mecopia-back,mecopia-web,mecopia-web-admin

# Frecuencia de chequeo (ms). Por defecto 60 s.
CHECK_INTERVAL_MS=60000

# Intervalo entre re-alertas mientras un servicio siga caído (ms). Por defecto 5 min.
ALERT_INTERVAL_MS=300000

# Correo del destinatario de las alertas
ALERT_TO=nandezgarcia@gmail.com

# Remitente (debe coincidir con la cuenta OAuth2 configurada)
MAIL_FROM_NAME=Mecopia Watchdog
MAIL_USER=adrian.ortega@in2ai.com

# Credenciales OAuth2 de Gmail (mismas que usa /root/mecopia-web-backend/.env)
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_REFRESH_TOKEN=

# Fichero de estado persistente (evita spam)
STATE_FILE=data/state.json

# Si es true, no envía correos (útil para probar la lectura de PM2)
DRY_RUN=false
